{
  "name": "reverb",
  "version": "0.0.0",
  "private": true,
  "description": "Reverb monorepo — Next.js web, Trigger.dev jobs, and shared packages.",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@reverb/web",
    "dev:jobs": "turbo run dev --filter=@reverb/jobs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml,css}\""
  },
  "devDependencies": {
    "@reverb/config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@supabase/supabase-js": "2.49.10"
    }
  }
}
