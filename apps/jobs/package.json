{
  "name": "@reverb/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "trigger dev",
    "build": "trigger deploy --skip-deploy",
    "deploy": "trigger deploy",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .trigger .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@reverb/ai": "workspace:*",
    "@reverb/db": "workspace:*",
    "@reverb/domain": "workspace:*",
    "@reverb/email": "workspace:*",
    "@reverb/media": "workspace:*",
    "@reverb/srs": "workspace:*",
    "@trigger.dev/sdk": "^3.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@reverb/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "trigger.dev": "^3.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
