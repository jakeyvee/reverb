# Reverb jobs (Trigger.dev) — local development env
# Copy to apps/jobs/.env.local. See docs/env-vars.md for full reference.
#
# Notes:
#   - `trigger.dev dev` will inject TRIGGER_SECRET_KEY/TRIGGER_PROJECT_ID from
#     its own credentials store after `trigger.dev login`; these are listed
#     here for completeness and for non-Trigger local runners.
#   - GOOGLE_APPLICATION_CREDENTIALS (path) works locally; on the hosted
#     Trigger.dev runtime use GOOGLE_APPLICATION_CREDENTIALS_JSON instead.

# Supabase (jobs always use the service role — they run server-side and need
# to bypass RLS for ingest, scheduling, and admin reads).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# AI providers
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_TTS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Email (Resend) + inbound
RESEND_API_KEY=
# Sender for lesson_ready / lesson_failed emails (must be a verified Resend
# domain or sandbox sender, e.g. "Reverb <onboarding@resend.dev>").
RESEND_FROM=
# Public base URL for "Open lesson" / "Retry processing" CTAs in emails.
APP_URL=
VINCENT_UPLOAD_EMAIL=

# App config
HOUSEHOLD_TIMEZONE=
