{
  "extends": "@reverb/config/tsconfig/next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@reverb/ai": ["../../packages/ai/src/index.ts"],
      "@reverb/ai/*": ["../../packages/ai/src/*"],
      "@reverb/db": ["../../packages/db/src/index.ts"],
      "@reverb/db/*": ["../../packages/db/src/*"],
      "@reverb/domain": ["../../packages/domain/src/index.ts"],
      "@reverb/domain/*": ["../../packages/domain/src/*"],
      "@reverb/email": ["../../packages/email/src/index.ts"],
      "@reverb/email/*": ["../../packages/email/src/*"],
      "@reverb/srs": ["../../packages/srs/src/index.ts"],
      "@reverb/srs/*": ["../../packages/srs/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".turbo", "dist"]
}
