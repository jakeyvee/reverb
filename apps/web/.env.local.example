# Reverb web app — local development env
# Copy to apps/web/.env.local. See docs/env-vars.md for full reference.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Trigger.dev — needed if the web app enqueues background jobs from server actions.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# Email (Resend)
RESEND_API_KEY=

# App config
ALLOWED_EMAILS=
VINCENT_UPLOAD_EMAIL=
HOUSEHOLD_TIMEZONE=
