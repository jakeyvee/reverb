{
  "name": "@reverb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(db) no tests yet\"",
    "db:types": "supabase gen types typescript --local > src/types.generated.ts",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "@reverb/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "supabase": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
