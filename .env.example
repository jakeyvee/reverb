# =============================================================================
# Reverb — root environment template
# =============================================================================
# This file is the canonical catalog of every variable Reverb consumes.
# Copy to `.env.local` for local development. See docs/env-vars.md for the
# matrix of scope, owner, and browser-safety for each variable, and
# docs/deployment.md for how these get wired into Vercel / Trigger.dev.
#
# Rule of thumb:
#   NEXT_PUBLIC_* → safe to ship to the browser bundle.
#   Everything else → server-only. Never expose via NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (DB / Auth / Storage)
# -----------------------------------------------------------------------------
# Project URL and anon key are public-by-design and used in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS. SERVER ONLY. Used by apps/jobs and apps/web RSC/route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI providers (server-only)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Google Cloud Text-to-Speech — set exactly one of these. `getGoogleTtsClient()`
# checks them in this order:
#   1. GOOGLE_APPLICATION_CREDENTIALS_JSON: full service-account JSON inlined
#      as a string. Preferred on Trigger.dev (no persistent filesystem).
#   2. GOOGLE_TTS_API_KEY: API-key auth (simplest, works on any runtime).
#   3. GOOGLE_APPLICATION_CREDENTIALS: path to a JSON file (local dev only).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_TTS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Email (Resend) — server-only
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Sender shown in lesson_ready / lesson_failed emails. Must be on a verified
# Resend domain (or "Reverb <onboarding@resend.dev>" for sandbox runs).
RESEND_FROM=
# Public base URL the email links point at (no trailing slash). Used in the
# "Open lesson" / "Retry processing" CTAs.
APP_URL=

# -----------------------------------------------------------------------------
# Trigger.dev (background jobs) — server-only
# -----------------------------------------------------------------------------
# Created in the Trigger.dev dashboard. The SDK reads TRIGGER_SECRET_KEY.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# -----------------------------------------------------------------------------
# App config (server-only unless prefixed NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Comma-separated allow-list of emails permitted to sign in.
ALLOWED_EMAILS=
# Inbound email address used to forward content uploads to Vincent.
VINCENT_UPLOAD_EMAIL=
# IANA timezone used for scheduling and daily rollovers (e.g. "America/Los_Angeles").
HOUSEHOLD_TIMEZONE=

# -----------------------------------------------------------------------------
# Media processing (apps/jobs) — server-only, all optional
# -----------------------------------------------------------------------------
# Opt-in for the silence-trim pre-pass on uploaded lessons. Off by default
# because ffmpeg's `silenceremove` filter is brittle on lossy inputs; see
# packages/media/src/silence.ts for the rationale and the follow-up plan.
MEDIA_SILENCE_TRIM_ENABLED=
# Optional overrides for the static binaries shipped via ffmpeg-static /
# ffprobe-static. Leave empty to use the bundled binaries.
MEDIA_FFMPEG_PATH=
MEDIA_FFPROBE_PATH=
